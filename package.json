{
  "name": "hlm-browser",
  "version": "1.1.1",
  "description": "A configurable, origin-restricted application browser",
  "desktopName": "hlm-browser.desktop",
  "author": "HLM Browser contributors",
  "license": "UNLICENSED",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:desktop": "node scripts/smoke.cjs",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:windows": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg zip"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "playwright": "1.61.1"
  },
  "build": {
    "appId": "com.hlm.browser",
    "productName": "HLM Browser",
    "files": [
      "desktop/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "syncDesktopName": true,
      "category": "Network",
      "maintainer": "HLM Browser contributors"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Camera access supports IT-approved application features on approved HTTPS origins.",
        "NSMicrophoneUsageDescription": "Microphone access supports IT-approved application features on approved HTTPS origins."
      }
    }
  }
}
